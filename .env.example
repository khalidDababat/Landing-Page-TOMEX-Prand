# Public site metadata
NEXT_PUBLIC_APP_NAME=TOMEX

# json-server API that serves data/db.json (npm run server)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-only API URL used by Server Components (read at runtime, never sent to the browser).
# Falls back to NEXT_PUBLIC_API_URL when unset.
API_URL=http://127.0.0.1:3001

